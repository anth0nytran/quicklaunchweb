# =============================================================================
# QuickLaunchWeb Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to version control
# =============================================================================

# -----------------------------------------------------------------------------
# Site Configuration
# -----------------------------------------------------------------------------
# Your production URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://quicklaunchweb.us

# -----------------------------------------------------------------------------
# Demo Gate (for /demo)
# -----------------------------------------------------------------------------
# Username + password for the demo login
DEMO_USER=demo_user
DEMO_PASS=demo_password
# Long random string used to sign the auth cookie
DEMO_AUTH_SECRET=replace-with-a-long-random-string

# -----------------------------------------------------------------------------
# Stripe Configuration
# -----------------------------------------------------------------------------
# Get these from https://dashboard.stripe.com/apikeys
# Use TEST keys for development, LIVE keys for production

# Stripe Secret Key (starts with sk_test_ or sk_live_)
# ⚠️ NEVER expose this in client-side code
STRIPE_SECRET_KEY=sk_test_your_secret_key_here

# Stripe Publishable Key (starts with pk_test_ or pk_live_)
# This is safe to expose in client-side code
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here

# -----------------------------------------------------------------------------
# Stripe Price IDs - Base Plans (Recurring Monthly)
# -----------------------------------------------------------------------------
# Create these in Stripe Dashboard → Products → Add Product
# These should be RECURRING prices billed MONTHLY

# Starter Plan - $99/month
STRIPE_PRICE_STARTER_MONTHLY=price_starter_monthly_here

# Growth Engine Plan - $199/month
STRIPE_PRICE_GROWTH_MONTHLY=price_growth_monthly_here

# City Dominator Plan - $399/month
STRIPE_PRICE_CITY_DOMINATOR_MONTHLY=price_city_dominator_monthly_here

# Upfront Plans (pay 3 months now, get month 4 free, monthly starts in month 5)
# These should be ONE-TIME prices used on the initial invoice only
STRIPE_PRICE_STARTER_UPFRONT=price_starter_upfront_here
STRIPE_PRICE_GROWTH_UPFRONT=price_growth_upfront_here
STRIPE_PRICE_CITY_DOMINATOR_UPFRONT=price_city_dominator_upfront_here

# -----------------------------------------------------------------------------
# Stripe Price IDs - Recurring Add-ons (Monthly)
# -----------------------------------------------------------------------------
# These should be RECURRING prices billed MONTHLY

# Instant Text Alerts - $29/month
STRIPE_PRICE_TEXT_ALERTS=price_text_alerts_here

# Monthly Conversion Boost - $49/month
STRIPE_PRICE_UNLIMITED_EDITS=price_unlimited_edits_here

# -----------------------------------------------------------------------------
# Stripe Price IDs - One-Time Add-ons
# -----------------------------------------------------------------------------
# These should be ONE-TIME prices

# Domain Connection Service - $99 one-time
STRIPE_PRICE_DOMAIN_ROUTING=price_domain_routing_here

# Domain Registration - $50 one-time (yearly renewal handled separately)
STRIPE_PRICE_DOMAIN_REGISTRATION=price_domain_registration_here

# Google Business Boost - $199 one-time
STRIPE_PRICE_GOOGLE_BOOST=price_google_boost_here

# -----------------------------------------------------------------------------
# Stripe Webhook (Optional - for production)
# -----------------------------------------------------------------------------
# Get this from Stripe Dashboard → Developers → Webhooks
# Required for: subscription updates, payment failures, cancellations
# STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# -----------------------------------------------------------------------------
# Web3Forms Configuration
# -----------------------------------------------------------------------------
# Get these from https://web3forms.com/
# Used for form submissions - these are safe to expose in client-side code (public keys)

# Custom Website Request Form
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=your_web3forms_access_key_here

# Support Request Form
NEXT_PUBLIC_WEB3FORMS_SUPPORT_ACCESS_KEY=your_web3forms_support_access_key_here

# -----------------------------------------------------------------------------
# Instagram Lead Form (Resend + Google Sheets)
# -----------------------------------------------------------------------------
# Used by app/api/instagram/route.ts

# Resend API key
RESEND_API_KEY=re_your_resend_api_key_here

# Where lead notifications are sent
LEAD_TO_EMAIL=you@example.com

# Verified sender in Resend
LEAD_FROM_EMAIL=QuickLaunchWeb <leads@quicklaunchweb.us>

# Google service account email (from the service account JSON)
GOOGLE_SERVICE_ACCOUNT_EMAIL=service-account@your-project.iam.gserviceaccount.com

# Google private key from the service account JSON.
# Keep the literal \n characters when placing it in .env files.
GOOGLE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n
# Optional alias if you use this naming convention instead:
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n

# Google Sheet target (spreadsheet ID from the sheet URL)
GOOGLE_SHEET_ID=your_google_sheet_id_here

# Optional sheet tab name (or any range containing the tab name, e.g. Sheet1!A1)
# The API writes columns A:R automatically.
GOOGLE_SHEET_RANGE=Sheet1

# -----------------------------------------------------------------------------
# Meta Pixel + Conversions API (Instagram landing)
# -----------------------------------------------------------------------------
# Pixel ID is used by browser events in app/instagram/layout.tsx
NEXT_PUBLIC_META_PIXEL_ID=your_meta_pixel_id_here

# Optional Page ID for instagram-related event parameters
NEXT_PUBLIC_META_PAGE_ID=your_meta_page_id_here

# Optional server-side Page ID override
META_PAGE_ID=your_meta_page_id_here

# Server-side Conversions API token (keep secret)
META_ACCESS_TOKEN=your_meta_access_token_here

# Legacy alias still supported by code
META_CONVERSIONS_API_TOKEN=your_meta_conversions_api_token_here

# Optional server-side pixel override (defaults to NEXT_PUBLIC_META_PIXEL_ID)
META_PIXEL_ID=your_meta_pixel_id_here

# Optional Graph API version override (defaults to v20.0)
META_GRAPH_API_VERSION=v20.0

# Optional test event code from Events Manager
META_TEST_EVENT_CODE=
