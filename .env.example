# =============================================================================
# QuickLaunchWeb Environment Variables  
# =============================================================================
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to version control
# =============================================================================

NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Demo gate (for /demo)
DEMO_USER=demo_user
DEMO_PASS=demo_password
# Long random string used to sign the auth cookie
DEMO_AUTH_SECRET=replace-with-a-long-random-string

# Stripe Keys - Get from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_YOUR_KEY_HERE
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_YOUR_KEY_HERE

# Stripe Price IDs
STRIPE_PRICE_STARTER_MONTHLY=price_YOUR_PRICE_ID
STRIPE_PRICE_STARTER_UPFRONT=price_YOUR_PRICE_ID
STRIPE_PRICE_GROWTH_MONTHLY=price_YOUR_PRICE_ID
STRIPE_PRICE_GROWTH_UPFRONT=price_YOUR_PRICE_ID
STRIPE_PRICE_CITY_DOMINATOR_MONTHLY=price_YOUR_PRICE_ID
STRIPE_PRICE_CITY_DOMINATOR_UPFRONT=price_YOUR_PRICE_ID
STRIPE_PRICE_TEXT_ALERTS=price_YOUR_PRICE_ID
STRIPE_PRICE_DOMAIN_ROUTING=price_YOUR_PRICE_ID
STRIPE_PRICE_GOOGLE_BOOST=price_YOUR_PRICE_ID
STRIPE_PRICE_PHOTO_SHOOT=price_YOUR_PRICE_ID
STRIPE_PRICE_AD_CREATIVE=price_YOUR_PRICE_ID
STRIPE_PRICE_BRAND_PACKAGE=price_YOUR_PRICE_ID

# Stripe Webhook (for post-checkout automation)
# Get from: Stripe Dashboard → Developers → Webhooks → Signing secret
STRIPE_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET
# Optional: separate email for internal enrollment alerts (falls back to LEAD_TO_EMAIL)
INTERNAL_ALERT_EMAIL=your@email.com

# Resend (for Instagram lead form + any email routes)
RESEND_API_KEY=re_YOUR_KEY_HERE
LEAD_TO_EMAIL=your@email.com
LEAD_FROM_EMAIL=QuickLaunchWeb <leads@quicklaunchweb.us>

# Google Sheets (service account for lead tracking)
# Create at: https://console.cloud.google.com → IAM → Service Accounts
# Share your Google Sheet with the service account email (Editor access)
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----"

# Google Analytics 4
NEXT_PUBLIC_GA_MEASUREMENT_ID=YOUR_ID
NEXT_PUBLIC_GA_DEBUG=TRUE_OR_FALSE

# Meta Pixel + Conversions API (Instagram landing)
# Pixel ID is safe client-side and required for browser events
NEXT_PUBLIC_META_PIXEL_ID=YOUR_META_PIXEL_ID
# Optional: your connected Meta Page ID for richer event context
NEXT_PUBLIC_META_PAGE_ID=YOUR_META_PAGE_ID
# Optional server-side page ID override
META_PAGE_ID=YOUR_META_PAGE_ID
# Server-side Conversions API token (keep secret)
META_ACCESS_TOKEN=YOUR_META_ACCESS_TOKEN
# Legacy alias still supported by code
META_CONVERSIONS_API_TOKEN=YOUR_META_CAPI_TOKEN
# Optional server-side override if different from NEXT_PUBLIC_META_PIXEL_ID
META_PIXEL_ID=YOUR_META_PIXEL_ID
# Optional Graph API version override
META_GRAPH_API_VERSION=v20.0
# Optional test event code from Events Manager (remove in production)
